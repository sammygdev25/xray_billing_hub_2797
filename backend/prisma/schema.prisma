generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  isActive  Boolean  @default(true) @map("is_active")
  isStaff   Boolean  @default(false) @map("is_staff")
  passwordHash  String? @map("password_hash")
  fullName  String? @map("full_name")
  role  String @default("patient")
  googleId  String? @map("google_id") @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  patients  Patient[]
  scheduledBys  Exam[]  @relation("Exam_scheduledBy")
  radiologists  Exam[]  @relation("Exam_radiologist")
  users  Invoice[]  @relation("Invoice_user")
  createdBys  Invoice[]  @relation("Invoice_createdBy")

  @@map("users")
}
model RefreshToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique @map("token_hash")
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("refresh_tokens")
}
model Patient {
  id        Int      @id @default(autoincrement())
  userId  Int  @map("user_id")
  user  User  @relation(fields: [userId], references: [id])
  dateOfBirth  DateTime  @map("date_of_birth")
  phone  String
  address  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  exams  Exam[]

  @@map("patients")
}
model Exam {
  id        Int      @id @default(autoincrement())
  patientId  Int  @map("patient_id")
  patient  Patient  @relation(fields: [patientId], references: [id])
  examType  String  @map("exam_type")
  scheduledById  Int?  @map("scheduled_by_id")
  scheduledBy  User?  @relation("Exam_scheduledBy", fields: [scheduledById], references: [id])
  radiologistId  Int?  @map("radiologist_id")
  radiologist  User?  @relation("Exam_radiologist", fields: [radiologistId], references: [id])
  scheduledAt  DateTime  @map("scheduled_at")
  status  String
  studyNotes  String  @map("study_notes")
  price  Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  invoices  Invoice[]

  @@map("exams")
}
model Invoice {
  id        Int      @id @default(autoincrement())
  userId  Int  @map("user_id")
  user  User  @relation("Invoice_user", fields: [userId], references: [id])
  examId  Int  @map("exam_id")
  exam  Exam  @relation(fields: [examId], references: [id])
  createdById  Int?  @map("created_by_id")
  createdBy  User?  @relation("Invoice_createdBy", fields: [createdById], references: [id])
  totalAmount  Float  @map("total_amount")
  status  String
  stripePaymentIntentId  String  @map("stripe_payment_intent_id")
  paidAt DateTime? @map("paid_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  stripeSessionId String? @unique @map("stripe_session_id")

  @@map("invoices")
}
